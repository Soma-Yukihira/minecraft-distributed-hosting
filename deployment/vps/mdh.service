# Minecraft Distributed Hosting control plane + Minecraft relay. Installed by install.sh as
# /etc/systemd/system/mdh.service. Logs: journalctl -u mdh
[Unit]
Description=Minecraft Distributed Hosting (control plane and relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=mdh
Group=mdh
EnvironmentFile=/etc/mdh/mdh.env
WorkingDirectory=/var/lib/mdh
# One process, one worker: the lease authority lives in it (docs/ARCHITECTURE.md).
ExecStart=/opt/mdh/current/bin/python -m mdh_server serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# The VPS also runs Pi-hole, Unbound and WireGuard: a leak here must never starve them.
MemoryHigh=256M
MemoryMax=384M
TasksMax=128
LimitNOFILE=8192

# Least privilege: own data directory writable, nothing else; no capability (ports > 1024).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/mdh
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0027

[Install]
WantedBy=multi-user.target
