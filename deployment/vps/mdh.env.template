# Configuration of the control plane on the VPS: /etc/mdh/mdh.env (root:mdh, 640).
# Written once by install.sh, never overwritten by an update: edit it, then
# "sudo systemctl restart mdh". Every variable is described in .env.example.

# Loopback only: Nginx (port 8443, TLS) is the only way in.
MDH_API_BIND=127.0.0.1:@API_PORT@

MDH_DATABASE_PATH=/var/lib/mdh/database/mdh.sqlite3
MDH_STORAGE_DIR=/var/lib/mdh/storage

# Minecraft relay. nip.io resolves <anything>.@PUBLIC_IP@.nip.io to @PUBLIC_IP@: server and
# personal addresses work without owning a domain name.
MDH_RELAY_ENABLED=1
MDH_RELAY_BIND=0.0.0.0
MDH_RELAY_PORT=@RELAY_PORT@
MDH_RELAY_DOMAIN=@PUBLIC_IP@.nip.io

MDH_REGISTRATION_MODE=invite
MDH_DEFAULT_GROUP_QUOTA_GB=20
