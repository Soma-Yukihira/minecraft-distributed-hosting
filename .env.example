# Control-plane settings. On the VPS they live in /etc/mdh/mdh.env (root:mdh, 640), written
# once by deployment/vps/install.sh from deployment/vps/mdh.env.template. Never commit a real one.
# The server holds no secret key: sessions are random tokens stored hashed in the database.

# The API only listens on loopback; Nginx (port 8443, TLS) proxies to it.
MDH_API_BIND=127.0.0.1:8090

# Minecraft relay (TCP). Players type MDH_RELAY_DOMAIN, <server label>.MDH_RELAY_DOMAIN or their
# personal address <token>.MDH_RELAY_DOMAIN. Without a domain name, <IP>.nip.io resolves all of
# them to the VPS; with one: "A mc.example.org" AND a wildcard "A *.mc.example.org".
MDH_RELAY_ENABLED=1
MDH_RELAY_BIND=0.0.0.0
MDH_RELAY_PORT=25565
MDH_RELAY_DOMAIN=203.0.113.10.nip.io
# Players behind one public IP (a LAN party) share these limits.
MDH_RELAY_MAX_PER_IP=8
MDH_RELAY_CONNECTIONS_PER_MINUTE=30
MDH_RELAY_MAX_CONNECTIONS=256

# Persistent data
MDH_DATABASE_PATH=/var/lib/mdh/database/mdh.sqlite3
MDH_STORAGE_DIR=/var/lib/mdh/storage
# Installers published for the automatic updates (install.sh publish-client).
# Default: "updates" next to MDH_STORAGE_DIR.
# MDH_UPDATES_DIR=/var/lib/mdh/updates

# Registration: "invite" (default) or "open"
MDH_REGISTRATION_MODE=invite

# Lease timing (seconds). Changing these requires re-reading docs/ARCHITECTURE.md section 2.3.
MDH_LEASE_TTL_S=30
MDH_LEASE_GRACE_S=15

# Storage
MDH_DEFAULT_GROUP_QUOTA_GB=20
MDH_KEEP_LAST_VERSIONS=5
MDH_KEEP_HOURLY_HOURS=24
MDH_KEEP_DAILY_DAYS=7

# Interactive API documentation at /api/v1/docs (local development only)
MDH_EXPOSE_DOCS=0
